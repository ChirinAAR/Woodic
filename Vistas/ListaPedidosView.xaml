<UserControl x:Class="Woodic.Vistas.ListaPedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Listado de Pedidos"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextAccentBrush}" />
            <TextBlock Text="Consulte, imprima o elimine pedidos guardados en el sistema"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Orders Table Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
            <DataGrid x:Name="dgPedidos"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      AutoGenerateColumns="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="dgPedidos_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID Pedido" Binding="{Binding IdPedido}" Width="90" MinWidth="80" FontWeight="Bold" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Nombre}" Width="1.5*" MinWidth="140" />
                    <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="120" MinWidth="100" />
                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="2*" MinWidth="160" />
                    <DataGridTextColumn Header="Módulos" Binding="{Binding CantidadModulos}" Width="80" MinWidth="70" />
                    <DataGridTextColumn Header="Precio Total" Binding="{Binding PrecioFormateado}" Width="120" MinWidth="110" FontWeight="SemiBold" Foreground="#34D399" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=\{0:dd/MM/yyyy\}}" Width="100" MinWidth="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action Bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Actions -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnEliminarPedido"
                        Content="🗑️ Borrar Pedido"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="btnEliminarPedido_Click" />
            </StackPanel>

            <!-- Right Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnVerCortes"
                        Content="📄 Ver Listado de Cortes"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,10,0"
                        Click="btnVerCortes_Click" />

                <Button x:Name="btnImprimirPresupuesto"
                        Content="🖨️ Imprimir Presupuesto"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{DynamicResource ButtonSuccessBackgroundBrush}"
                        BorderBrush="{DynamicResource ButtonSuccessHoverBrush}"
                        Click="btnImprimirPresupuesto_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
