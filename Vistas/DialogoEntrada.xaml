<Window x:Class="Woodic.Vistas.DialogoEntrada"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Woodic" Height="190" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="Segoe UI, Bahnschrift, Arial">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblMensaje"
                   Text="Ingrese el valor:"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBox x:Name="txtValor"
                 Grid.Row="1"
                 Height="32"
                 VerticalAlignment="Top"
                 FontSize="14"
                 KeyDown="txtValor_KeyDown" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnAceptar"
                    Content="Aceptar"
                    Style="{DynamicResource ActionButtonStyle}"
                    Width="85"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="btnAceptar_Click" />
            <Button x:Name="btnCancelar"
                    Content="Cancelar"
                    Style="{DynamicResource NavButtonStyle}"
                    Width="85"
                    Height="30"
                    Click="btnCancelar_Click" />
        </StackPanel>
    </Grid>
</Window>
