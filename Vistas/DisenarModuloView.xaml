<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Woodic.Vistas.DisenarModuloView"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" av:DesignWidth="909.857">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Diseño Modulos"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="35" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Altura" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" />
                        <TextBox x:Name="txtAltura" Grid.Column="1" Text="1800" Height="32" ToolTip="Altura en mm (máx 2600)" />
                        <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="35" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ancho" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" />
                        <TextBox x:Name="txtAncho" Grid.Column="1" Text="900" Height="32" ToolTip="Ancho en mm (máx 2600)" />
                        <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="35" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Profundidad" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" />
                        <TextBox x:Name="txtProfundidad" Grid.Column="1" Text="500" Height="32" ToolTip="Profundidad en mm (máx 1830)" />
                        <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Formato" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" />
                        <ComboBox x:Name="cmbFormato" Grid.Column="1" Height="32" SelectionChanged="cmbFormato_SelectionChanged">
                            <ComboBoxItem Content="Completo" />
                            <ComboBoxItem Content="Escritorio (Sin zócalo inf.)" />
                            <ComboBoxItem Content="Bajomesada (Sin cabezal sup.)" />
                        </ComboBox>
                    </Grid>
                    <Button x:Name="btnAplicarMedidas"
                            Content="Aplicar Medidas"
                            Style="{DynamicResource ActionButtonStyle}"
                            Height="32"
                            Margin="0,0,0,16"
                            Click="btnAplicarMedidas_Click" />
                    <TextBlock Text="Elementos"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,10" />
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="Divisorios" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Height="24" Width="81" />
                                <Button x:Name="btnDeshacerDivisorios"
                                        Content="Deshacer"
                                        DockPanel.Dock="Right"
                                        Style="{DynamicResource NavButtonStyle}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Click="btnDeshacerDivisorios_Click" />
                            </DockPanel>
                            <Button x:Name="btnDivisorioHorizontal"
                                    Content="Añadir Divisorio Horizontal"
                                    Style="{DynamicResource ActionButtonStyle}"
                                    Margin="0,0,0,6"
                                    Click="btnDivisorioHorizontal_Click" />
                            <Button x:Name="btnDivisorioVertical"
                                    Content="Añadir Divisorio Vertical"
                                    Style="{DynamicResource ActionButtonStyle}"
                                    Click="btnDivisorioVertical_Click" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="Banquinas" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="btnDeshacerBanquinas"
                                        Content="Deshacer"
                                        DockPanel.Dock="Right"
                                        Style="{DynamicResource NavButtonStyle}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Click="btnDeshacerBanquinas_Click" />
                            </DockPanel>
                            <Button x:Name="btnBanquinaHorizontal"
                                    Content="Añadir Banquina Horizontal"
                                    Style="{DynamicResource ActionButtonStyle}"
                                    Margin="0,0,0,6"
                                    Click="btnBanquinaHorizontal_Click" />
                            <Button x:Name="btnBanquinaVertical"
                                    Content="Añadir Banquina Vertical"
                                    Style="{DynamicResource ActionButtonStyle}"
                                    Click="btnBanquinaVertical_Click" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="Cajones" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="btnDeshacerCajones"
                                        Content="Deshacer"
                                        DockPanel.Dock="Right"
                                        Style="{DynamicResource NavButtonStyle}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Click="btnDeshacerCajones_Click" />
                            </DockPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cantidad" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                                <TextBox x:Name="txtCantidadCajones" Grid.Column="1" Text="2" Height="28" />
                            </Grid>
                            <Button x:Name="btnSeleccionarCajones"
                                    Content="Seleccionar Ubicacion"
                                    Style="{DynamicResource ActionButtonStyle}"
                                    Click="btnSeleccionarCajones_Click" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="Puertas" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="btnDeshacerPuertas"
                                        Content="Deshacer"
                                        DockPanel.Dock="Right"
                                        Style="{DynamicResource NavButtonStyle}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Click="btnDeshacerPuertas_Click" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton x:Name="rbPuertaSimple" Content="1 Puerta" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,15,0" />
                                <RadioButton x:Name="rbPuertaDoble" Content="2 Puertas (Doble)" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button x:Name="btnSeleccionarPuertas"
                                    Content="Seleccionar Ubicacion"
                                    Style="{DynamicResource ActionButtonStyle}"
                                    Click="btnSeleccionarPuertas_Click" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="lblInstruccion"
                               Text=""
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextAccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,12" />
                    <Button x:Name="btnTerminar"
                            Content="Terminar"
                            Style="{DynamicResource ActionButtonStyle}"
                            Height="44"
                            FontSize="16"
                            FontWeight="Bold"
                            Click="btnTerminar_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <TextBlock x:Name="lblTituloVistaPrevia"
                               Text="Vista Previa Modulo 1"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button x:Name="btnCamIsometrica"
                            Content="Vista Libre"
                            Style="{DynamicResource NavButtonStyle}"
                            Padding="8,3"
                            FontSize="11"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Click="btnCamIsometrica_Click" />
                    <Button x:Name="btnCamFrente"
                            Content="Frente"
                            Style="{DynamicResource NavButtonStyle}"
                            Padding="8,3"
                            FontSize="11"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Click="btnCamFrente_Click" />
                    <TextBlock x:Name="lblModuloGuardado"
                               Text=""
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#10B981"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>
                <Border Grid.Row="1"
                        Background="#1E2028"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid x:Name="gridViewport"
                          Background="Transparent"
                          MouseDown="viewport3D_MouseDown"
                          MouseMove="viewport3D_MouseMove"
                          MouseUp="viewport3D_MouseUp"
                          MouseWheel="viewport3D_MouseWheel"
                          MouseLeave="gridViewport_MouseLeave"
                          Cursor="Hand">
                        <Viewport3D x:Name="viewport3D">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="mainCamera"
                                                   Position="1500,1200,2800"
                                                   LookDirection="-1500,-1200,-2800"
                                                   UpDirection="0,1,0"
                                                   FieldOfView="50" />
                            </Viewport3D.Camera>
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#707070" />
                                        <DirectionalLight Color="#FFFFFF" Direction="-1,-1.5,-2" />
                                        <DirectionalLight Color="#606060" Direction="1,1,1" />
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                            <ModelVisual3D x:Name="furnitureVisual" />
                        </Viewport3D>
                        <Border Background="#90000000"
                                CornerRadius="6"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12">
                            <TextBlock Text="Click: Girar 3D | Rueda: Zoom "
                                       FontSize="11"
                                       Foreground="#D1D5DB" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>