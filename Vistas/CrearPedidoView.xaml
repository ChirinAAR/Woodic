<UserControl x:Class="Woodic.Vistas.CrearPedidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="28"
            Margin="20"
            MaxWidth="950"
            HorizontalAlignment="Center">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Título Principal -->
            <TextBlock Text="Crear Pedido"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,24" />

            <!-- Formulario a Dos Columnas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Datos del Cliente -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Datos del Cliente"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <!-- Nombre -->
                    <TextBlock Text="- Nombre"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="txtNombre"
                             Height="36"
                             Margin="0,0,0,18"
                             ToolTip="Nombre y apellido del cliente" />

                    <!-- Contacto -->
                    <TextBlock Text="- Contacto"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="txtContacto"
                             Height="36"
                             Margin="0,0,0,18"
                             ToolTip="Teléfono del cliente (solo números)" />

                    <!-- Dirección -->
                    <TextBlock Text="- Direccion"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="txtDireccion"
                             Height="36"
                             Margin="0,0,0,26"
                             ToolTip="Dirección del domicilio de entrega" />

                    <!-- Botón Confirmar -->
                    <Button x:Name="btnConfirmar"
                            Content="Confirmar"
                            Style="{DynamicResource ActionButtonStyle}"
                            HorizontalAlignment="Left"
                            Width="140"
                            Height="38"
                            FontSize="15"
                            Click="btnConfirmar_Click" />
                </StackPanel>

                <!-- Columna Derecha: Datos del Pedido -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Datos del Pedido"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <!-- Compuesto -->
                    <TextBlock Text="- Compuesto"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox x:Name="chkAglomerado"
                                  Content="Aglomerado"
                                  IsChecked="True"
                                  Margin="0,0,25,0"
                                  Checked="chkAglomerado_Checked" />
                        <CheckBox x:Name="chkMDF"
                                  Content="MDF"
                                  Checked="chkMDF_Checked" />
                    </StackPanel>

                    <!-- Línea de colores -->
                    <TextBlock Text="- Linea de colores"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="cmbLinea"
                              Height="36"
                              Margin="0,0,0,18"
                              SelectionChanged="cmbLinea_SelectionChanged" />

                    <!-- Color -->
                    <TextBlock Text="- Color"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="cmbColor"
                              Height="36"
                              Margin="0,0,0,18" />

                    <!-- Cantidad de Módulos -->
                    <TextBlock Text="- Cantidad de Modulos"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="txtCantidadModulos"
                             Text="1"
                             Height="36"
                             Width="120"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,18"
                             ToolTip="Cantidad de muebles a diseñar" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>