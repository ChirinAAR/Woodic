<UserControl x:Class="Woodic.Vistas.FinalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Resultados Despiece y Presupuesto"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextAccentBrush}" />
                <TextBlock x:Name="lblDetalleSubtitulo"
                           Text="Resumen de cortes optimizados por módulo y cálculo de costos"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border x:Name="badgePresupuestoRapido"
                    Grid.Column="1"
                    Background="#1E3A8A"
                    CornerRadius="8"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock Text="⚡ MODO PRESUPUESTO RÁPIDO"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#93C5FD" />
            </Border>
        </Grid>

        <!-- Despiece Table Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
            <DataGrid x:Name="dgDespiece"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      AutoGenerateColumns="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MinHeight="180" />
        </Border>

        <!-- Financial Summary Card -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Cantidad de Placas necesarias: "
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="lblCantidadPlacas"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="lblInfoPlaca"
                                   Text=""
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="lblDesgloseCostos"
                               Text="Material: $0.00 | Herrajes (30%): $0.00"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Total Box -->
                <Border Grid.Column="1"
                        Background="#0F2F24"
                        BorderBrush="#059669"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="20,10">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="PRECIO APROXIMADO"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#6EE7B7"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="lblPrecioTotal"
                                   Text="$0.00"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#34D399"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Action Buttons Bar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnVerCortes"
                        Content="📄 Ver Listado de Cortes"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,10,0"
                        Click="btnVerCortes_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnImprimir"
                        Content="🖨️ Imprimir Presupuesto"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,10,0"
                        Click="btnImprimir_Click" />

                <Button x:Name="btnFinalizar"
                        Content="💾 Finalizar / Volver"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{DynamicResource ButtonSuccessBackgroundBrush}"
                        BorderBrush="{DynamicResource ButtonSuccessHoverBrush}"
                        Click="btnFinalizar_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
