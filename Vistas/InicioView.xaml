<UserControl x:Class="Woodic.Vistas.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Título Bienvenido -->
            <TextBlock Text="Bienvenido"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,20" />

            <!-- Logotipo Woodic de la Sierra -->
            <Border CornerRadius="12"
                    Background="Transparent"
                    Padding="10">
                <Image Source="/Vistas/logo.png"
                       MaxWidth="540"
                       MaxHeight="360"
                       Stretch="Uniform"
                       HorizontalAlignment="Center">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black" />
                    </Image.Effect>
                </Image>
            </Border>

            <!-- Acceso Rápido Informativo -->
            <TextBlock Text="Seleccione una opción del menú superior para comenzar"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
