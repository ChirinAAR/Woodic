<UserControl x:Class="Woodic.Vistas.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1050"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Catalogo"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Administre el catálogo de colores disponibles"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Placas Grid Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 Colores Disponibles"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button x:Name="btnEliminarPlaca"
                                Grid.Column="1"
                                Content="🗑️ Borrar color seleccionado"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="btnEliminarPlaca_Click" />
                    </Grid>

                    <DataGrid x:Name="dgPlacas"
                              Grid.Row="1"
                              MinHeight="250"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              AutoGenerateColumns="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdPlaca}" Width="60" MinWidth="50" FontWeight="Bold" />
                            <DataGridTextColumn Header="Línea" Binding="{Binding Linea}" Width="140" MinWidth="110" />
                            <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="130" MinWidth="100" />
                            <DataGridTextColumn Header="Compuesto" Binding="{Binding Compuesto}" Width="120" MinWidth="100" />
                            <DataGridTextColumn Header="Veta" Binding="{Binding BetaTexto}" Width="90" MinWidth="80" />
                            <DataGridTextColumn Header="Dimensiones (mm)" Binding="{Binding DimensionesTexto}" Width="140" MinWidth="125" />
                            <DataGridTextColumn Header="Precio Placa" Binding="{Binding PrecioFormateado}" Width="120" MinWidth="100" FontWeight="SemiBold" Foreground="#34D399" />
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*" MinWidth="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Add Placa Form Card -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <TextBlock Text="➕ Añadir Color"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="lblEstadoPlaca"
                                   DockPanel.Dock="Right"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#34D399"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Linea -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Línea:" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="txtLinea" />
                        </StackPanel>

                        <!-- Color -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="Color:" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="txtColor" />
                        </StackPanel>

                        <!-- Proveedor -->
                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                            <TextBlock Text="Proveedor:" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="txtProveedor" />
                        </StackPanel>

                        <!-- Precio -->
                        <StackPanel Grid.Row="0" Grid.Column="6" Margin="0,0,0,10">
                            <TextBlock Text="Precio ($):" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="txtPrecio" />
                        </StackPanel>

                        <!-- Compuesto -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Compuesto:" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbAglomerado" Content="Aglomerado" IsChecked="True" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <RadioButton x:Name="rbMdf" Content="MDF" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Veta / Beta -->
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Tiene Veta:" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbConVeta" Content="Si" IsChecked="True" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}" Checked="rbConVeta_Checked" />
                                <RadioButton x:Name="rbSinVeta" Content="No" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Medidas Ancho x Largo -->
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Text="Medidas (Ancho x Largo mm):" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txtAnchoPlaca" Text="1830" Width="60" Margin="0,0,6,0" />
                                <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="txtLargoPlaca" Text="2400" Width="60" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Boton Guardar Placa -->
                        <Button x:Name="btnGuardarPlaca"
                                Grid.Row="1" Grid.Column="6"
                                Content="💾 Guardar"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{DynamicResource ButtonSuccessBackgroundBrush}"
                                BorderBrush="{DynamicResource ButtonSuccessHoverBrush}"
                                VerticalAlignment="Bottom"
                                Height="34"
                                Click="btnGuardarPlaca_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
